{
	"schemaVersion": 1,
	"id": "ognpricetooltips",
	"version": "${version}",
	"name": "OG-Network QOL",
	"description": "A client-side QOL mod for OG Network, featuring price tooltips, rune visualizers, and inventory values.",
	"authors": [
		"YourNameHere"
	],
	"contact": {},
	"license": "CC0-1.0",
	"icon": "assets/ognpricetooltips/icon.png",
	"environment": "client",
	"accessWidener": "ognpricetooltips.accesswidener",
	"entrypoints": {
		"client": [
			"com.example.ognpricetooltips.PriceTooltipsClient",
			"com.example.ognpricetooltips.ShulkerBoxValueTooltip",
			"com.example.ognpricetooltips.RuneHighlighter"
		],
		"modmenu": [
			"com.example.ognpricetooltips.ModMenuIntegration"
		]
	},
	"mixins": [
		"ognpricetooltips.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}